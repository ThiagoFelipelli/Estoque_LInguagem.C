{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Estoque",
            "type": "shell",
            "command": "C:\\Program Files (x86)\\Dev-Cpp\\MinGW64\\bin\\gcc.exe",
            "args": [
                "${workspaceFolder}\\estoque-grupo10\\main.c",
                "${workspaceFolder}\\estoque-grupo10\\produto.c",
                "${workspaceFolder}\\estoque-grupo10\\util.c",
                "${workspaceFolder}\\estoque-grupo10\\categoria.c",
                "-o",
                "${workspaceFolder}\\estoque.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "type": "cppbuild",
            "label": "C/C++: gcc build active file",
            "command": "/usr/bin/gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}